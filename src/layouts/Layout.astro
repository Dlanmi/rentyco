---
import '../styles/global.css';

export interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  /** Page title — should be unique, include brand (under 60 chars for SERPs) */
  title: string;
  /** Page description — unique, under 160 chars */
  description: string;
  /** Canonical URL (absolute). Defaults to current path on rentyco.app */
  canonicalUrl?: string;
  /** Slug for the per-page OG image (matches /og/[slug].png). Falls back to 'default' */
  ogSlug?: string;
  /** Manually override OG image URL (absolute) */
  ogImage?: string;
  /** og:type — "website" (default) or "article" */
  ogType?: 'website' | 'article';
  /** For articles: ISO date of first publish */
  publishedTime?: string;
  /** For articles: ISO date of last modification */
  modifiedTime?: string;
  /** For articles: author name */
  author?: string;
  /** For articles: section/category */
  section?: string;
  /** For articles: tags/keywords */
  tags?: string[];
  /** Breadcrumb trail for nested pages (outputs BreadcrumbList JSON-LD) */
  breadcrumbs?: BreadcrumbItem[];
  /** Additional page-specific JSON-LD schema (Product, Service, Article, FAQPage, etc.) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Prevent search engine indexing (drafts, legal pages you don't want ranked, etc.) */
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  ogSlug,
  ogImage,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author,
  section,
  tags = [],
  breadcrumbs,
  jsonLd,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ? new URL(Astro.site.toString()).origin : 'https://rentyco.app';
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const og = ogImage || `${siteUrl}/og/${ogSlug || 'default'}.png`;
const robotsContent = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// Build breadcrumb JSON-LD if provided
const breadcrumbSchema = breadcrumbs?.length
  ? {
      '@context': 'https://schema.org',
      '@id': `${canonical}#breadcrumb`,
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: b.url.startsWith('http') ? b.url : `${siteUrl}${b.url}`,
      })),
    }
  : null;

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'es-CO',
  isPartOf: { '@id': `${siteUrl}/#website` },
  about: { '@id': `${siteUrl}/#organization` },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: og,
  },
  ...(breadcrumbSchema ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
};

// Organization + WebSite (sitewide identity)
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Renty',
  legalName: 'Renty SAS',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/icon.svg`,
    width: 64,
    height: 64,
  },
  description: 'Sistema de scoring alternativo que permite a los colombianos arrendar sin codeudor, basado en historial de pagos reales.',
  foundingDate: '2026',
  areaServed: {
    '@type': 'Country',
    name: 'Colombia',
  },
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'CO',
    addressLocality: 'Bogotá',
  },
  knowsLanguage: 'es-CO',
  contactPoint: [
    {
      '@type': 'ContactPoint',
      email: 'soporte@rentyco.app',
      contactType: 'customer service',
      availableLanguage: ['Spanish', 'es'],
      areaServed: 'CO',
    },
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: 'Renty',
  description: 'El arriendo sin barreras en Colombia',
  inLanguage: 'es-CO',
  publisher: { '@id': `${siteUrl}/#organization` },
};
---

<!doctype html>
<html lang="es-CO" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="theme-color" content="#0D6B58" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Canonical + hreflang -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-CO" href={canonical} />
    <link rel="alternate" hreflang="es" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Favicons + PWA -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="mask-icon" href="/icon.svg" color="#0D6B58" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Renty" />
    <meta name="application-name" content="Renty" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Renty" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:locale:alternate" content="es_ES" />
    <meta property="og:image" content={og} />
    <meta property="og:image:secure_url" content={og} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && author && <meta property="article:author" content={author} />}
    {ogType === 'article' && section && <meta property="article:section" content={section} />}
    {ogType === 'article' &&
      tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:site" content="@rentyco_app" />
    <meta name="twitter:creator" content="@rentyco_app" />

    <!-- JSON-LD: Organization + WebSite + WebPage (sitewide) -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} is:inline />

    <!-- JSON-LD: BreadcrumbList (when provided) -->
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
    )}

    <!-- JSON-LD: Page-specific schemas -->
    {jsonLd && Array.isArray(jsonLd)
      ? jsonLd.map((schema) => (
          <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
        ))
      : jsonLd && (
          <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
        )}
  </head>
  <body class="min-h-screen">
    <!-- Skip navigation — a11y -->
    <a href="#main-content" class="skip-nav">Ir al contenido principal</a>

    <!-- Scroll progress bar -->
    <div data-scroll-progress class="fixed top-0 left-0 z-[60] h-[3px] w-0 bg-gradient-to-r from-teal to-teal-light" style="will-change: width;"></div>

    <slot />

    <!-- Sticky floating CTA (mobile + desktop, hidden near waitlist) -->
    <div data-floating-cta class="fixed bottom-6 right-6 z-40 translate-y-20 opacity-0 transition-all duration-300" style="pointer-events: none;" aria-hidden="true">
      <a
        href="#waitlist"
        class="flex items-center gap-2 rounded-full bg-teal px-5 py-3 font-heading text-[14px] font-600 text-white no-underline shadow-xl shadow-teal/25 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-2xl hover:shadow-teal/30"
        style="pointer-events: auto;"
        tabindex="-1"
      >
        Únete gratis
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
      </a>
    </div>

    <!-- Back-to-top button -->
    <button
      type="button"
      data-back-to-top
      class="fixed bottom-6 left-6 z-40 flex h-10 w-10 translate-y-20 items-center justify-center rounded-full border border-border bg-surface opacity-0 shadow-lg transition-all duration-300 hover:border-teal hover:text-teal"
      style="pointer-events: none;"
      tabindex="-1"
      aria-hidden="true"
      aria-label="Volver al inicio"
    >
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
    </button>

    <!-- Global GSAP setup — counters, navbar scroll, generic reveals, confetti -->
    <script>
      const hasGsapTargets = Boolean(
        document.querySelector('[data-count], [data-reveal], [data-reveal-stagger]')
      );

      if (hasGsapTargets) {
        const { gsap, ScrollTrigger, reducedMotion } = await import('../lib/gsap');
        const parseRevealNumber = (value: string | undefined, fallback: number) => {
          const parsed = Number.parseFloat(value ?? '');
          return Number.isFinite(parsed) ? parsed : fallback;
        };

        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
          const target = parseFloat(el.dataset.count || '0');
          const suffix = el.dataset.suffix || '';
          const prefix = el.dataset.prefix || '';
          const decimals = el.dataset.decimals ? parseInt(el.dataset.decimals) : 0;
          ScrollTrigger.create({
            trigger: el,
            start: 'top 92%',
            once: true,
            onEnter: () => {
              gsap.to(
                { val: 0 },
                {
                  val: target,
                  duration: 1.8,
                  ease: 'power2.out',
                  onUpdate() {
                    el.textContent =
                      prefix +
                      (this.targets()[0] as { val: number }).val.toFixed(decimals) +
                      suffix;
                  },
                }
              );
            },
          });
        });

        if (!reducedMotion) {
          document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
            const start = el.dataset.revealStart || 'top 92%';
            const y = parseRevealNumber(el.dataset.revealY, 20);
            const duration = parseRevealNumber(el.dataset.revealDuration, 0.6);
            const delay = parseRevealNumber(el.dataset.revealDelay, 0);
            const fade = el.dataset.revealFade !== 'false';
            const fromVars = fade ? { y, autoAlpha: 0 } : { y };
            const toVars = fade ? { y: 0, autoAlpha: 1 } : { y: 0 };

            gsap.fromTo(
              el,
              fromVars,
              {
                ...toVars,
                duration,
                delay,
                ease: 'power2.out',
                force3D: true,
                overwrite: 'auto',
                clearProps: fade ? 'transform,opacity,visibility' : 'transform',
                scrollTrigger: { trigger: el, start, once: true },
              }
            );
          });

          document.querySelectorAll<HTMLElement>('[data-reveal-stagger]').forEach((el) => {
            const start = el.dataset.revealStart || 'top 92%';
            const y = parseRevealNumber(el.dataset.revealY, 20);
            const duration = parseRevealNumber(el.dataset.revealDuration, 0.5);
            const staggerEach = parseRevealNumber(el.dataset.revealStaggerEach, 0.1);
            const fade = el.dataset.revealFade !== 'false';
            const children = Array.from(el.children);
            if (!children.length) return;

            const fromVars = fade ? { y, autoAlpha: 0 } : { y };
            const toVars = fade ? { y: 0, autoAlpha: 1 } : { y: 0 };

            gsap.fromTo(
              children,
              fromVars,
              {
                ...toVars,
                stagger: staggerEach,
                duration,
                ease: 'power2.out',
                force3D: true,
                overwrite: 'auto',
                clearProps: fade ? 'transform,opacity,visibility' : 'transform',
                scrollTrigger: { trigger: el, start, once: true },
              }
            );
          });
        }

        if (document.fonts?.ready) {
          document.fonts.ready.then(() => ScrollTrigger.refresh());
        }
        window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });
      }

      let confettiRunning = false;
      (window as unknown as { rentyConfetti?: () => Promise<void> }).rentyConfetti = async () => {
        if (confettiRunning || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        confettiRunning = true;
        const { gsap } = await import('../lib/gsap');
        const colors = ['#0D6B58', '#10B981', '#E8634A', '#F59E0B', '#E8F5F0'];
        const container = document.querySelector<HTMLElement>('[data-waitlist]') || document.body;
        container.style.position = 'relative';

        const total = 50;
        let completed = 0;
        for (let i = 0; i < total; i++) {
          const dot = document.createElement('div');
          dot.style.cssText =
            'position:absolute;width:8px;height:8px;border-radius:50%;pointer-events:none;z-index:100;';
          dot.style.background = colors[Math.floor(Math.random() * colors.length)];
          dot.style.left = Math.random() * 100 + '%';
          dot.style.top = '50%';
          container.appendChild(dot);

          gsap.to(dot, {
            y: -(100 + Math.random() * 200),
            x: (Math.random() - 0.5) * 200,
            opacity: 0,
            duration: 1 + Math.random(),
            ease: 'power2.out',
            force3D: true,
            onComplete() {
              (this.targets()[0] as HTMLElement).remove();
              completed++;
              if (completed >= total) confettiRunning = false;
            },
          });
        }
      };
    </script>

    <script is:inline>
      // ── Unified scroll handler (progress, floating CTA, back-to-top, parallax) ──
      (function() {
        var navbar = document.querySelector('[data-navbar]');
        var progressBar = document.querySelector('[data-scroll-progress]');
        var floatingCta = document.querySelector('[data-floating-cta]');
        var floatingLink = floatingCta ? floatingCta.querySelector('a') : null;
        var backToTop = document.querySelector('[data-back-to-top]');
        var parallaxEls = document.querySelectorAll('[data-parallax]');
        var waitlistEl = document.getElementById('waitlist');
        var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var floatingShown = false;
        var bttShown = false;
        var nearWaitlist = false;
        var latestScrollY = window.scrollY;
        var ticking = false;

        function setFloatingState(visible) {
          if (!floatingCta || !floatingLink || visible === floatingShown) return;
          floatingCta.style.pointerEvents = visible ? '' : 'none';
          floatingCta.style.opacity = visible ? '1' : '0';
          floatingCta.style.transform = visible ? 'translateY(0)' : 'translateY(20px)';
          floatingCta.setAttribute('aria-hidden', String(!visible));
          if (visible) floatingLink.removeAttribute('tabindex');
          else floatingLink.setAttribute('tabindex', '-1');
          floatingShown = visible;
        }

        function setBackToTopState(visible) {
          if (!backToTop || visible === bttShown) return;
          backToTop.style.pointerEvents = visible ? '' : 'none';
          backToTop.style.opacity = visible ? '1' : '0';
          backToTop.style.transform = visible ? 'translateY(0)' : 'translateY(20px)';
          backToTop.setAttribute('aria-hidden', String(!visible));
          if (visible) backToTop.removeAttribute('tabindex');
          else backToTop.setAttribute('tabindex', '-1');
          bttShown = visible;
        }

        function updateUI() {
          var scrollY = latestScrollY;
          var h = document.documentElement.scrollHeight - window.innerHeight;
          var pct = h > 0 ? scrollY / h : 0;

          if (navbar) {
            navbar.classList.toggle('is-scrolled', scrollY > 80);
          }

          if (progressBar) progressBar.style.width = (pct * 100) + '%';

          if (floatingCta) {
            if (waitlistEl && !('IntersectionObserver' in window)) {
              var rect = waitlistEl.getBoundingClientRect();
              nearWaitlist = rect.top < window.innerHeight && rect.bottom > 0;
            }
            setFloatingState(pct > 0.15 && !nearWaitlist);
          }

          setBackToTopState(scrollY > window.innerHeight);

          if (!reducedMotion && parallaxEls.length) {
            for (var i = 0; i < parallaxEls.length; i++) {
              var speed = parseFloat(parallaxEls[i].dataset.parallax) || 0;
              parallaxEls[i].style.transform = 'translateY(' + (scrollY * speed) + 'px)';
            }
          }
        }

        function queueUpdate() {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(function() {
            updateUI();
            ticking = false;
          });
        }

        if (waitlistEl && 'IntersectionObserver' in window) {
          new IntersectionObserver(function(entries) {
            nearWaitlist = Boolean(entries[0] && entries[0].isIntersecting);
            queueUpdate();
          }, { threshold: 0.15 }).observe(waitlistEl);
        }

        if (navbar || progressBar || floatingCta || backToTop || parallaxEls.length) {
          updateUI();
          window.addEventListener('scroll', function() {
            latestScrollY = window.scrollY;
            queueUpdate();
          }, { passive: true });
          window.addEventListener('resize', function() {
            latestScrollY = window.scrollY;
            queueUpdate();
          }, { passive: true });
        }

        if (backToTop) {
          backToTop.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      })();
    </script>
  </body>
</html>
