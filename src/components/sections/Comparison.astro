        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <p class="mt-3 font-body text-[13px] text-ink-muted">Sin costo · Sin documentos</p>
    </div>
  </div>
</section>

<script>
  import { gsap, reveal, reducedMotion } from '../../lib/gsap';

  if (!reducedMotion && document.querySelector('[data-compare]')) {
    const mm = gsap.matchMedia();

    mm.add('(min-width: 1024px)', () => {
      reveal('[data-compare-old] > *', { x: -20, opacity: 0, stagger: 0.1, duration: 0.5 }, '[data-compare]');
      reveal('[data-compare-new] > *', { x: 20, opacity: 0, stagger: 0.1, duration: 0.5, delay: 0.3 }, '[data-compare]');
    });

    mm.add('(max-width: 1023px)', () => {
      reveal('[data-compare-old] > *', { y: 16, opacity: 0, stagger: 0.08, duration: 0.4 }, '[data-compare]');
      reveal('[data-compare-new] > *', { y: 16, opacity: 0, stagger: 0.08, duration: 0.4, delay: 0.2 }, '[data-compare]');
    });
  }
</script>
