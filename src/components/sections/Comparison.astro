      <!-- VS divider — mobile only -->
      <div class="flex items-center justify-center gap-3 py-1 lg:hidden">
        <div class="h-px flex-1 bg-border"></div>
        <span class="font-heading text-[13px] font-700 tracking-wider text-coral uppercase">vs</span>
