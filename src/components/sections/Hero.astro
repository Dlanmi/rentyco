---
import { WAITLIST_COUNT_LABEL } from '../../lib/waitlist';
---

<section class="relative flex min-h-[90vh] items-center overflow-hidden px-6 pt-24 pb-16 lg:px-12" id="inicio">
  <!-- Decorative gradient blobs — parallax via data attr -->
  <div data-parallax="0.08" class="pointer-events-none absolute -right-32 -top-32 h-[500px] w-[500px] rounded-full opacity-[0.07]" style="background: radial-gradient(circle, var(--color-teal) 0%, transparent 70%); will-change: transform;"></div>
  <div data-parallax="0.12" class="pointer-events-none absolute -left-48 bottom-0 h-[400px] w-[400px] rounded-full opacity-[0.05]" style="background: radial-gradient(circle, var(--color-coral) 0%, transparent 70%); will-change: transform;"></div>

  <div class="mx-auto grid max-w-7xl items-center gap-10 lg:grid-cols-2 lg:gap-20">
    <!-- Text -->
    <div class="text-center lg:text-left">
      <!-- Decorative accent bar -->
      <div class="mb-6 flex justify-center lg:justify-start">
        <div class="h-1 w-12 rounded-full bg-teal"></div>
      </div>

      <h1 data-hero-title class="font-display text-[clamp(2.5rem,5.5vw,4.2rem)] leading-[1.08] tracking-tight text-ink">
        <span class="block">El arriendo</span>
        <span class="block text-teal">sin barreras.</span>
      </h1>

      <p data-hero-text class="mx-auto mt-6 max-w-lg font-body text-lg leading-relaxed text-ink-secondary lg:mx-0">
        7.3 millones de familias en Colombia arriendan, pero el sistema las trata como riesgo.
        ¿Pagas cumplido hace años? Da igual: sin codeudor con finca raíz, no existes.
        Renty cambia eso — aquí vale cómo pagas, no cuánto tienes.
      </p>

      <div data-hero-ctas class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <a
          href="#waitlist"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-teal px-7 py-3.5 font-heading text-[15px] font-600 text-white no-underline shadow-lg shadow-teal/20 transition-all duration-200 hover:-translate-y-0.5 hover:bg-teal-dark hover:shadow-xl hover:shadow-teal/25"
        >
          Arrienda sin barreras
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a
          href="#como-funciona"
          class="inline-flex items-center justify-center rounded-xl border border-border bg-white px-7 py-3.5 font-heading text-[15px] font-600 text-ink no-underline transition-all duration-200 hover:border-teal hover:text-teal"
        >
          Mira cómo funciona
        </a>
      </div>

      <div data-hero-proof class="mt-8 flex items-center justify-center gap-6 border-t border-border pt-6 lg:justify-start">
        <div class="flex -space-x-2">
          <div class="h-8 w-8 rounded-full bg-teal-lighter border-2 border-sand flex items-center justify-center font-heading text-[10px] font-700 text-teal">CM</div>
          <div class="h-8 w-8 rounded-full bg-coral-light border-2 border-sand flex items-center justify-center font-heading text-[10px] font-700 text-coral">JR</div>
          <div class="h-8 w-8 rounded-full bg-teal-lighter border-2 border-sand flex items-center justify-center font-heading text-[10px] font-700 text-teal">LP</div>
          <div class="h-8 w-8 rounded-full bg-sand-dark border-2 border-sand flex items-center justify-center font-heading text-[10px] font-700 text-ink-muted">+</div>
        </div>
        <span class="font-body text-sm text-ink-muted">
          <strong class="text-ink-secondary">{WAITLIST_COUNT_LABEL}</strong> familias en lista de espera
        </span>
      </div>
    </div>

    <!-- Visual: Shield SVG -->
    <div class="flex items-center justify-center lg:justify-end">
      <svg viewBox="0 0 480 480" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full max-w-[260px] lg:max-w-[400px]" aria-hidden="true">
        <path d="M240 50 L410 140 L410 310 Q410 420 240 450 Q70 420 70 310 L70 140 Z" fill="#E8F5F0" opacity="0.5"/>
        <path d="M240 80 L380 155 L380 300 Q380 390 240 415 Q100 390 100 300 L100 155 Z" stroke="#0D6B58" stroke-width="0.8" fill="none" opacity="0.2"/>

        <!-- House structure - roof -->
        <circle class="hero-dot" cx="240" cy="130" r="5" fill="#0D6B58"/>
        <circle class="hero-dot" cx="210" cy="155" r="3.5" fill="#10B981"/>
        <circle class="hero-dot" cx="180" cy="180" r="4" fill="#0D6B58"/>
        <circle class="hero-dot" cx="155" cy="200" r="3" fill="#10B981"/>
        <circle class="hero-dot" cx="270" cy="155" r="3.5" fill="#10B981"/>
        <circle class="hero-dot" cx="300" cy="180" r="4" fill="#0D6B58"/>
        <circle class="hero-dot" cx="325" cy="200" r="3" fill="#10B981"/>

        <line class="hero-line" x1="240" y1="130" x2="210" y2="155" stroke="#0D6B58" stroke-width="0.6" opacity="0.3"/>
        <line class="hero-line" x1="210" y1="155" x2="180" y2="180" stroke="#0D6B58" stroke-width="0.6" opacity="0.3"/>
        <line class="hero-line" x1="180" y1="180" x2="155" y2="200" stroke="#0D6B58" stroke-width="0.6" opacity="0.3"/>
        <line class="hero-line" x1="240" y1="130" x2="270" y2="155" stroke="#0D6B58" stroke-width="0.6" opacity="0.3"/>
        <line class="hero-line" x1="270" y1="155" x2="300" y2="180" stroke="#0D6B58" stroke-width="0.6" opacity="0.3"/>
        <line class="hero-line" x1="300" y1="180" x2="325" y2="200" stroke="#0D6B58" stroke-width="0.6" opacity="0.3"/>

        <!-- Walls -->
        <circle class="hero-dot" cx="155" cy="230" r="3.5" fill="#57534E"/>
        <circle class="hero-dot" cx="155" cy="265" r="3" fill="#A8A29E"/>
        <circle class="hero-dot" cx="155" cy="300" r="4" fill="#57534E"/>
        <circle class="hero-dot" cx="155" cy="335" r="3" fill="#A8A29E"/>
        <circle class="hero-dot" cx="325" cy="230" r="3.5" fill="#57534E"/>
        <circle class="hero-dot" cx="325" cy="265" r="3" fill="#A8A29E"/>
        <circle class="hero-dot" cx="325" cy="300" r="4" fill="#57534E"/>
        <circle class="hero-dot" cx="325" cy="335" r="3" fill="#A8A29E"/>

        <line class="hero-line" x1="155" y1="200" x2="155" y2="335" stroke="#A8A29E" stroke-width="0.5" opacity="0.3"/>
        <line class="hero-line" x1="325" y1="200" x2="325" y2="335" stroke="#A8A29E" stroke-width="0.5" opacity="0.3"/>
        <line class="hero-line" x1="155" y1="335" x2="325" y2="335" stroke="#A8A29E" stroke-width="0.5" opacity="0.3"/>

        <!-- Window -->
        <circle class="hero-dot" cx="195" cy="240" r="3" fill="#0D6B58"/>
        <circle class="hero-dot" cx="220" cy="240" r="3" fill="#0D6B58"/>
        <circle class="hero-dot" cx="195" cy="265" r="3" fill="#0D6B58"/>
        <circle class="hero-dot" cx="220" cy="265" r="3" fill="#0D6B58"/>
        <line class="hero-line" x1="195" y1="240" x2="220" y2="240" stroke="#0D6B58" stroke-width="0.5" opacity="0.3"/>
        <line class="hero-line" x1="195" y1="265" x2="220" y2="265" stroke="#0D6B58" stroke-width="0.5" opacity="0.3"/>
        <line class="hero-line" x1="195" y1="240" x2="195" y2="265" stroke="#0D6B58" stroke-width="0.5" opacity="0.3"/>
        <line class="hero-line" x1="220" y1="240" x2="220" y2="265" stroke="#0D6B58" stroke-width="0.5" opacity="0.3"/>

        <!-- Door -->
        <circle class="hero-dot" cx="280" cy="335" r="3.5" fill="#E8634A"/>
        <circle class="hero-dot" cx="305" cy="335" r="3.5" fill="#E8634A"/>
        <circle class="hero-dot" cx="280" cy="305" r="3" fill="#E8634A"/>
        <circle class="hero-dot" cx="305" cy="305" r="3" fill="#E8634A"/>
        <circle class="hero-dot" cx="292" cy="290" r="3.5" fill="#E8634A"/>
        <line class="hero-line" x1="280" y1="335" x2="280" y2="305" stroke="#E8634A" stroke-width="0.5" opacity="0.4"/>
        <line class="hero-line" x1="305" y1="335" x2="305" y2="305" stroke="#E8634A" stroke-width="0.5" opacity="0.4"/>
        <line class="hero-line" x1="280" y1="305" x2="292" y2="290" stroke="#E8634A" stroke-width="0.5" opacity="0.4"/>
        <line class="hero-line" x1="305" y1="305" x2="292" y2="290" stroke="#E8634A" stroke-width="0.5" opacity="0.4"/>

        <!-- Ambient dots -->
        <circle class="hero-dot" cx="110" cy="120" r="2" fill="#A8A29E" opacity="0.3"/>
        <circle class="hero-dot" cx="370" cy="110" r="2.5" fill="#0D6B58" opacity="0.2"/>
        <circle class="hero-dot" cx="90" cy="280" r="2" fill="#E8634A" opacity="0.2"/>
        <circle class="hero-dot" cx="390" cy="260" r="2" fill="#10B981" opacity="0.2"/>
        <circle class="hero-dot" cx="240" cy="390" r="2.5" fill="#A8A29E" opacity="0.2"/>

        <!-- Checkmark -->
        <path class="hero-dot" d="M220 365 L235 380 L265 350" stroke="#0D6B58" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.6"/>
      </svg>
    </div>
  </div>
</section>

<script>
  import { gsap, reducedMotion } from '../../lib/gsap';

  if (!reducedMotion && document.querySelector('[data-hero-title]')) {
    const mm = gsap.matchMedia();

    // Desktop (≥1024px) — staged entrance
    mm.add('(min-width: 1024px)', () => {
      const tl = gsap.timeline({ delay: 0.3 });
      tl.from('[data-hero-title] > *', { y: 30, opacity: 0, stagger: 0.12, duration: 0.7, ease: 'power2.out', force3D: true })
        .from('[data-hero-text]', { opacity: 0, duration: 0.6, force3D: true }, '-=0.3')
        .from('[data-hero-ctas] > *', { y: 16, opacity: 0, stagger: 0.1, duration: 0.5, force3D: true }, '-=0.2')
        .from('[data-hero-proof]', { opacity: 0, duration: 0.4, force3D: true }, '-=0.1');

      gsap.from('.hero-dot', { scale: 0, opacity: 0, duration: 0.4, stagger: 0.025, delay: 0.8, ease: 'back.out(1.7)', force3D: true });
      gsap.from('.hero-line', { opacity: 0, duration: 1, delay: 2, ease: 'power2.inOut', force3D: true });
    });

    // Mobile (<1024px) — single unified entrance
    mm.add('(max-width: 1023px)', () => {
      gsap.from('[data-hero-title], [data-hero-text], [data-hero-ctas], [data-hero-proof]', {
        y: 20, opacity: 0, stagger: 0.1, duration: 0.5, delay: 0.2, ease: 'power2.out', force3D: true,
      });
    });
  }
</script>
