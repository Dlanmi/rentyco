---
const steps = [
  { n: '01', title: 'Crea tu perfil', desc: 'Regístrate en 2 minutos. Sin documentos. Solo tu información básica y tu historial de dónde has vivido.', color: '#0D6B58',
    icon: '<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="20" cy="14" r="6"/><path d="M8 34c0-6.627 5.373-12 12-12s12 5.373 12 12"/></svg>' },
  { n: '02', title: 'Verificamos tu historial', desc: 'Contactamos a tus arrendadores anteriores y cruzamos datos de servicios públicos y pagos digitales.', color: '#10B981',
    icon: '<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M20 4l14 8v12c0 8-14 14-14 14S6 32 6 24V12L20 4z"/><path d="M14 20l4 4 8-8"/></svg>' },
  { n: '03', title: 'Recibe tu Renty Score', desc: 'Un puntaje basado en tu comportamiento real: pagos, continuidad, referencias. No en tu patrimonio.', color: '#E8634A',
    icon: '<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="4" y="24" width="8" height="12" rx="1"/><rect x="16" y="16" width="8" height="20" rx="1"/><rect x="28" y="8" width="8" height="28" rx="1"/></svg>' },
  { n: '04', title: 'Arrienda sin barreras', desc: 'Presenta tu perfil verificado a arrendadores. Sin codeudor, sin depósitos absurdos, sin esperar meses.', color: '#0D6B58',
    icon: '<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6 20L20 8l14 12"/><path d="M10 18v14a2 2 0 002 2h16a2 2 0 002-2V18"/><rect x="16" y="24" width="8" height="10"/></svg>' },
];
---

<section class="py-24 lg:py-32" id="como-funciona">
  <div class="mx-auto max-w-7xl px-6 lg:px-12">
    <div class="mb-14 text-center lg:mb-20">
      <span class="mb-3 inline-block font-mono text-[12px] font-500 tracking-[0.12em] uppercase text-teal">
        Cómo funciona
      </span>
      <h2 class="font-display text-[clamp(1.8rem,4vw,2.8rem)] leading-tight text-ink">
        Tu puntaje en 4 pasos.<br />Así de fácil.
      </h2>
    </div>

    <div data-steps class="relative grid gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <div data-steps-line class="absolute top-7 right-[12%] left-[12%] hidden h-px bg-border lg:block"></div>

      {steps.map((s) => (
        <div data-step class="relative z-10 rounded-2xl border border-border bg-surface p-7 text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-black/[0.03]">
          <div class="mx-auto mb-4 flex h-9 w-9 items-center justify-center rounded-full font-mono text-[13px] font-500 text-white" style={`background-color: ${s.color}`}>
            {s.n}
          </div>
          <div class="mx-auto mb-4 flex h-11 w-11 items-center justify-center" style={`color: ${s.color}`}>
            <div set:html={s.icon} />
          </div>
          <h3 class="mb-2 font-heading text-[16px] font-700 text-ink">{s.title}</h3>
          <p class="font-body text-[14px] leading-relaxed text-ink-muted">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap, reveal, reducedMotion } from '../../lib/gsap';

  if (!reducedMotion && document.querySelector('[data-steps]')) {
    reveal('[data-step]', { y: 24, opacity: 0, stagger: 0.18, duration: 0.6 }, '[data-steps]');

    // Horizontal connecting line draws in on desktop only
    if (document.querySelector('[data-steps-line]') && window.matchMedia('(min-width: 1024px)').matches) {
      gsap.fromTo('[data-steps-line]',
        { scaleX: 0 },
        {
          scaleX: 1, transformOrigin: 'left', duration: 1.2, ease: 'power2.inOut', force3D: true,
          scrollTrigger: { trigger: '[data-steps]', start: 'top 85%', once: true },
        }
      );
    }
  }
</script>
