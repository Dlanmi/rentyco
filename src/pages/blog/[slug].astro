---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/sections/Navbar.astro';
import Footer from '../../components/sections/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' });
}

const categoryLabels: Record<string, string> = {
  inquilinos: 'Inquilinos',
  arrendadores: 'Arrendadores',
  legal: 'Legal',
  mercado: 'Mercado',
  producto: 'Producto',
};

const categoryColors: Record<string, string> = {
  inquilinos: 'bg-teal/10 text-teal',
  arrendadores: 'bg-coral/10 text-coral',
  legal: 'bg-amber-100 text-amber-700',
  mercado: 'bg-emerald-100 text-emerald-700',
  producto: 'bg-violet-100 text-violet-700',
};

const canonical = `https://rentyco.app/blog/${post.id}`;
const ogImageUrl = `https://rentyco.app/og/blog/${post.id}.png`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "image": ogImageUrl,
  "datePublished": post.data.pubDate.toISOString(),
  "dateModified": (post.data.updatedDate || post.data.pubDate).toISOString(),
  "author": {
    "@type": "Person",
    "name": post.data.author,
  },
  "publisher": { "@id": "https://rentyco.app/#organization" },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
  "keywords": post.data.tags.join(', '),
  "articleSection": categoryLabels[post.data.category],
  "inLanguage": "es-CO",
};
---

<Layout
  title={`${post.data.title} — Blog Renty`}
  description={post.data.description}
  canonicalUrl={canonical}
  ogSlug={`blog/${post.id}`}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={(post.data.updatedDate || post.data.pubDate).toISOString()}
  author={post.data.author}
  section={categoryLabels[post.data.category]}
  tags={post.data.tags}
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Blog', url: '/blog' },
    { name: post.data.title, url: `/blog/${post.id}` },
  ]}
  jsonLd={jsonLd}
>
  <Navbar />

  <main id="main-content" tabindex="-1" class="pt-28 pb-20">
    <article class="mx-auto max-w-3xl px-6 lg:px-0">
      <!-- Meta -->
      <div class="mb-8">
        <a href="/blog" class="mb-6 inline-flex items-center gap-1.5 font-heading text-[13px] font-600 text-ink-muted no-underline transition-colors hover:text-teal">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12"/></svg>
          Volver al blog
        </a>

        <div class="mt-4 flex items-center gap-3">
          <span class:list={['rounded-full px-3 py-1 font-heading text-[11px] font-600', categoryColors[post.data.category]]}>
            {categoryLabels[post.data.category]}
          </span>
          {post.data.readingTime && (
            <span class="font-mono text-[12px] text-ink-muted">{post.data.readingTime} min de lectura</span>
          )}
        </div>

        <h1 class="mt-4 font-display text-[clamp(1.8rem,4vw,2.8rem)] leading-[1.12] text-ink">
          {post.data.title}
        </h1>

        <div class="mt-4 flex items-center gap-4 border-b border-border pb-6">
          <div class="flex items-center gap-2">
            <div class="flex h-8 w-8 items-center justify-center rounded-full bg-teal-lighter font-heading text-[11px] font-700 text-teal">
              {post.data.author.split(' ').map((w: string) => w[0]).join('').slice(0, 2)}
            </div>
            <span class="font-heading text-[13px] font-600 text-ink-secondary">{post.data.author}</span>
          </div>
          <span class="font-body text-[13px] text-ink-muted">{formatDate(post.data.pubDate)}</span>
        </div>
      </div>

      <!-- Content -->
      <div class="renty-prose prose prose-lg max-w-none
        prose-headings:font-heading prose-headings:font-700 prose-headings:text-ink
        prose-h2:mt-12 prose-h2:mb-5 prose-h2:text-[1.5rem] prose-h2:border-b prose-h2:border-border prose-h2:pb-3
        prose-h3:mt-9 prose-h3:mb-3 prose-h3:text-[1.2rem]
        prose-p:font-body prose-p:text-ink-secondary prose-p:leading-[1.8]
        prose-a:text-teal prose-a:font-600 prose-a:no-underline hover:prose-a:underline
        prose-strong:text-ink prose-strong:font-700
        prose-em:text-ink-secondary
        prose-ul:font-body prose-ul:text-ink-secondary
        prose-ol:font-body prose-ol:text-ink-secondary
        prose-li:my-1.5
        prose-blockquote:border-l-4 prose-blockquote:border-teal prose-blockquote:bg-teal-lighter/40 prose-blockquote:rounded-r-xl prose-blockquote:py-4 prose-blockquote:px-6 prose-blockquote:font-body prose-blockquote:text-ink prose-blockquote:not-italic prose-blockquote:font-500
        prose-code:font-mono prose-code:text-[14px] prose-code:text-teal prose-code:bg-teal-lighter/50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
        prose-hr:border-border prose-hr:my-10
        prose-img:rounded-xl prose-img:shadow-md
      ">
        <Content />
      </div>

      <!-- Tags -->
      {post.data.tags.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-2 border-t border-border pt-6">
          {post.data.tags.map((tag: string) => (
            <span class="rounded-full bg-sand-dark px-3 py-1 font-heading text-[11px] font-600 text-ink-muted">
              #{tag}
            </span>
          ))}
        </div>
      )}

      <!-- CTA -->
      <div class="mt-12 rounded-2xl bg-teal-lighter p-8 text-center">
        <h3 class="font-heading text-[18px] font-700 text-ink">¿Listo para tu Renty Score?</h3>
        <p class="mx-auto mt-2 max-w-md font-body text-[15px] text-ink-secondary">
          Únete a las familias en lista de espera y arrienda sin barreras.
        </p>
        <a href="/lista-de-espera" class="mt-5 inline-flex items-center gap-2 rounded-xl bg-teal px-6 py-3 font-heading text-[14px] font-600 text-white no-underline transition-all hover:-translate-y-0.5 hover:bg-teal-dark">
          Unirme a la lista
        </a>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
