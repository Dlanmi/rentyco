---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/sections/Navbar.astro';
import Footer from '../../components/sections/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [
  { id: 'todos', label: 'Todos' },
  { id: 'inquilinos', label: 'Inquilinos' },
  { id: 'arrendadores', label: 'Arrendadores' },
  { id: 'legal', label: 'Legal' },
  { id: 'mercado', label: 'Mercado' },
  { id: 'producto', label: 'Producto' },
];

const categoryLabels: Record<string, string> = {
  inquilinos: 'Inquilinos',
  arrendadores: 'Arrendadores',
  legal: 'Legal',
  mercado: 'Mercado',
  producto: 'Producto',
};

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' });
}

const categoryColors: Record<string, string> = {
  inquilinos: 'bg-teal/10 text-teal',
  arrendadores: 'bg-coral/10 text-coral',
  legal: 'bg-amber-100 text-amber-700',
  mercado: 'bg-emerald-100 text-emerald-700',
  producto: 'bg-violet-100 text-violet-700',
};

const blogJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': 'https://rentyco.app/blog#blog',
    url: 'https://rentyco.app/blog',
    name: 'Blog Renty',
    description: 'Guías, datos y perspectivas sobre el arriendo en Colombia.',
    inLanguage: 'es-CO',
    publisher: { '@id': 'https://rentyco.app/#organization' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: posts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://rentyco.app/blog/${post.id}`,
      name: post.data.title,
    })),
  },
];
---

<Layout
  title="Blog — Renty | Guías sobre arriendo en Colombia"
  description="Artículos sobre el mercado de arriendo en Colombia, derechos del inquilino, scoring alternativo y cómo arrendar sin codeudor. Información verificada con datos reales."
  canonicalUrl="https://rentyco.app/blog"
  ogSlug="blog"
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Blog', url: '/blog' },
  ]}
  jsonLd={blogJsonLd}
>
  <Navbar />
  <main id="main-content" tabindex="-1" class="pt-28 pb-20">
    <!-- Hero -->
    <section class="mx-auto max-w-7xl px-6 lg:px-12">
      <span class="mb-3 inline-block font-mono text-[12px] font-500 tracking-[0.12em] uppercase text-teal">Blog</span>
      <h1 class="font-display text-[clamp(2rem,4.5vw,3.2rem)] leading-tight text-ink">
        Guías, datos y perspectivas<br />sobre el arriendo en Colombia.
      </h1>
      <p class="mt-4 max-w-2xl font-body text-lg text-ink-secondary">
        Información que debería existir pero nadie reúne: derechos, datos del mercado, y cómo funciona
        el sistema que queremos cambiar.
      </p>
    </section>

    <!-- Category Filter -->
    <section class="mx-auto mt-10 max-w-7xl px-6 lg:px-12">
      <div data-blog-filter class="flex flex-wrap gap-2">
        {categories.map((cat) => (
          <button
            type="button"
            data-filter={cat.id}
            class:list={[
              'rounded-full border px-4 py-1.5 font-heading text-[13px] font-600 transition-all duration-200',
              cat.id === 'todos'
                ? 'border-teal bg-teal text-white'
                : 'border-border bg-surface text-ink-muted hover:border-teal hover:text-teal',
            ]}
            aria-pressed={cat.id === 'todos' ? 'true' : 'false'}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </section>

    <!-- Posts Grid -->
    <section class="mx-auto mt-12 max-w-7xl px-6 lg:px-12">
      <div data-blog-grid class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article
            data-blog-card
            data-category={post.data.category}
            class="group flex flex-col overflow-hidden rounded-2xl border border-border bg-surface transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-black/[0.04]"
          >
            <div class="flex h-48 items-center justify-center bg-gradient-to-br from-teal-lighter to-sand">
              <svg class="h-12 w-12 text-teal/30" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <div class="mb-3 flex items-center gap-3">
                <span class:list={['rounded-full px-2.5 py-0.5 font-heading text-[11px] font-600', categoryColors[post.data.category] || 'bg-gray-100 text-gray-600']}>
                  {categoryLabels[post.data.category] || post.data.category}
                </span>
                {post.data.readingTime && (
                  <span class="font-mono text-[11px] text-ink-muted">{post.data.readingTime} min</span>
                )}
              </div>
              <h2 class="mb-2 font-heading text-[17px] font-700 leading-snug text-ink group-hover:text-teal transition-colors duration-200">
                <a href={`/blog/${post.id}`} class="no-underline text-inherit">
                  {post.data.title}
                </a>
              </h2>
              <p class="mb-4 flex-1 font-body text-[14px] leading-relaxed text-ink-muted">
                {post.data.description}
              </p>
              <div class="flex items-center justify-between border-t border-border pt-4">
                <span class="font-body text-[12px] text-ink-muted">{formatDate(post.data.pubDate)}</span>
                <span class="font-heading text-[12px] font-600 text-ink-secondary">{post.data.author}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="mx-auto mt-20 max-w-7xl px-6 text-center lg:px-12">
      <div class="rounded-2xl border border-border bg-surface p-12">
        <h2 class="font-display text-[clamp(1.5rem,3vw,2rem)] text-ink">
          ¿Quieres ser de los primeros?
        </h2>
        <p class="mx-auto mt-3 max-w-md font-body text-ink-muted">
          Únete a la lista de espera y recibe tu Renty Score gratuito cuando lancemos en Bogotá.
        </p>
        <a href="/lista-de-espera" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-teal px-7 py-3.5 font-heading text-[15px] font-600 text-white no-underline transition-all duration-200 hover:-translate-y-0.5 hover:bg-teal-dark">
          Unirme a la lista
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline>
    // Category filter
    const filterBtns = document.querySelectorAll('[data-filter]');
    const cards = document.querySelectorAll('[data-blog-card]');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;

        filterBtns.forEach(b => {
          b.setAttribute('aria-pressed', 'false');
          b.classList.remove('border-teal', 'bg-teal', 'text-white');
          b.classList.add('border-border', 'bg-surface', 'text-ink-muted');
        });
        btn.setAttribute('aria-pressed', 'true');
        btn.classList.remove('border-border', 'bg-surface', 'text-ink-muted');
        btn.classList.add('border-teal', 'bg-teal', 'text-white');

        cards.forEach(card => {
          card.hidden = !(filter === 'todos' || card.dataset.category === filter);
        });
      });
    });
  </script>

  <script>
    import { reveal, reducedMotion } from '../../lib/gsap';
    if (!reducedMotion) {
      reveal('[data-blog-card]', { y: 20, opacity: 0, stagger: 0.1, duration: 0.5 }, '[data-blog-grid]');
    }
  </script>
</Layout>
