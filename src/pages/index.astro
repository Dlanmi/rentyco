---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import Problem from '../components/sections/Problem.astro';
import Comparison from '../components/sections/Comparison.astro';
import Steps from '../components/sections/Steps.astro';
import Score from '../components/sections/Score.astro';
import Testimonial from '../components/sections/Testimonial.astro';
import Landlords from '../components/sections/Landlords.astro';
import Waitlist from '../components/sections/Waitlist.astro';
import Footer from '../components/sections/Footer.astro';
---

<Layout
  title="Renty | Arrienda sin codeudor en Colombia"
  description="Renty es el sistema de scoring alternativo que permite a los colombianos arrendar sin codeudor. Basado en historial de pagos reales, no solo en Datacrédito. Únete a la lista de espera."
  canonicalUrl="https://rentyco.app/"
  ogSlug="home"
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <Hero />
    <Problem />
    <Comparison />
    <Steps />
    <Score />
    <Testimonial />
    <Landlords />
  </main>
  <Waitlist />
  <Footer />
</Layout>
