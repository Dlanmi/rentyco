---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/sections/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import WaitlistForm from '../components/sections/WaitlistForm.astro';
import { WAITLIST_COUNT_LABEL } from '../lib/waitlist';

const painPoints = [
  {
    icon: '<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="14" cy="14" r="6"/><path d="M4 34c0-5.523 4.477-10 10-10"/><circle cx="28" cy="14" r="6"/><path d="M18 34c0-5.523 4.477-10 10-10"/><path d="M34 18v6m0 4v.01"/></svg>',
    stat: '2',
    suffix: ' codeudores',
    title: 'Necesitas 2 codeudores con finca ra\u00edz',
    desc: 'Para rentas superiores a $1.5M en Bogot\u00e1, las inmobiliarias exigen dos personas con propiedad que se hagan responsables por ti. \u00bfNo los tienes? No arriendas.',
    source: 'Fedelonjas 2024',
  },
  {
    icon: '<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="20" cy="20" r="16"/><path d="M20 10v10l6 4"/></svg>',
    stat: '3.9',
    suffix: ' meses',
    title: '3.9 meses en promedio para arrendar',
    desc: 'Entre buscar, aplicar, conseguir documentos, esperar aprobaci\u00f3n y firmar, una familia bogotana tarda casi 4 meses en mudarse. Un proceso agotador.',
    source: 'Fedelonjas / Metrocuadrado 2024',
  },
  {
    icon: '<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M8 8h24v28H8z"/><path d="M14 16h12M14 22h12M14 28h8"/><path d="M4 36l8-8M36 36l-8-8" stroke-dasharray="2 2"/></svg>',
    stat: '57',
    suffix: '%',
    title: 'Contratos verbales sin protecci\u00f3n',
    desc: 'El 57% de los contratos de arriendo en Colombia son de palabra. En estratos 1-3 sube al 95%. Son COP $18 billones anuales en acuerdos sin garant\u00eda.',
    source: 'Fedelonjas 2024',
  },
  {
    icon: '<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M10 34V20l10-12 10 12v14"/><path d="M16 34v-8h8v8"/><path d="M6 18L20 6l14 12"/><path d="M30 14v-4h4v8"/><line x1="4" y1="4" x2="36" y2="36" stroke-dasharray="2 2"/></svg>',
    stat: '55.8',
    suffix: '%',
    title: 'Rechazados por ser informales',
    desc: '12.6 millones de colombianos trabajan sin contrato formal. Sin certificado laboral ni colillas de pago, quedan excluidos del arriendo formal.',
    source: 'DANE Q2 2024',
  },
];

const solutions = [
  {
    problem: 'Necesitas codeudor con finca ra\u00edz',
    solution: 'Tu historial de pago verificado reemplaza al codeudor',
    detail: 'Renty verifica c\u00f3mo has pagado arriendo, servicios y m\u00e1s. Eso se convierte en tu garant\u00eda real, no el patrimonio de otra persona.',
  },
  {
    problem: '3.9 meses buscando arriendo',
    solution: 'Perfil verificado en minutos, no en meses',
    detail: 'Crea tu perfil, conecta tus datos y recibe tu Renty Score. Los arrendadores ven un inquilino verificado desde el primer contacto.',
  },
  {
    problem: 'Contrato verbal sin protecci\u00f3n',
    solution: 'Contrato digital con respaldo para ambas partes',
    detail: 'Renty facilita contratos claros con t\u00e9rminos justos. Protecci\u00f3n real para ti y para quien te arrienda.',
  },
  {
    problem: 'Rechazado por ser informal',
    solution: 'Funciona para informales, independientes y migrantes',
    detail: 'Nuestro scoring alternativo usa datos reales: pagos de Nequi, Daviplata, servicios p\u00fablicos, referencias de arrendadores anteriores.',
  },
];

const journey = [
  { n: '01', title: 'Te registras', desc: 'En 2 minutos. Solo necesitas tu c\u00e9dula y tu correo. Nada m\u00e1s.', color: '#0D6B58' },
  { n: '02', title: 'Conectas tu historial', desc: 'Autorizas acceso a tus pagos de servicios, Nequi/Daviplata y referencias de arrendadores.', color: '#10B981' },
  { n: '03', title: 'Recibes tu Renty Score', desc: 'Un puntaje basado en tu comportamiento real de pago. No en tu patrimonio ni el de tu familia.', color: '#E8634A' },
  { n: '04', title: 'Aplicas a inmuebles', desc: 'Presenta tu perfil verificado a arrendadores que ya conf\u00edan en Renty. Sin codeudor.', color: '#0D6B58' },
  { n: '05', title: 'Firmas y te mudas', desc: 'Contrato digital, condiciones claras. Bienvenido a tu nuevo hogar.', color: '#10B981' },
];

const faqs = [
  {
    q: '\u00bfRenty es gratis para los inquilinos?',
    a: 'S\u00ed. Crear tu perfil y obtener tu Renty Score no tiene ning\u00fan costo. Renty se financia a trav\u00e9s de los servicios que ofrece a arrendadores e inmobiliarias, nunca cobr\u00e1ndole al inquilino.',
  },
  {
    q: '\u00bfCu\u00e1nto tarda la verificaci\u00f3n de mi historial?',
    a: 'El proceso inicial toma entre 5 y 15 minutos. Verificamos autom\u00e1ticamente tus pagos de servicios y billeteras digitales. Las referencias de arrendadores anteriores pueden tomar entre 24 y 48 horas.',
  },
  {
    q: '\u00bfQu\u00e9 pasa si tengo un mal historial crediticio en Datacr\u00e9dito?',
    a: 'Renty no depende exclusivamente de Datacr\u00e9dito. Nuestro scoring alternativo eval\u00faa tu comportamiento real de pago: arriendo, servicios p\u00fablicos, pagos digitales y referencias. Si has sido buen pagador en la vida real, eso cuenta.',
  },
  {
    q: '\u00bfNecesito tener empleo formal para usar Renty?',
    a: 'No. Renty fue dise\u00f1ado para incluir a trabajadores informales, independientes, freelancers y migrantes. El 55.8% de los colombianos trabaja en la informalidad, y creemos que su historial de pago es la mejor prueba de responsabilidad.',
  },
  {
    q: '\u00bfRenty funciona solo en Bogot\u00e1?',
    a: 'El lanzamiento inicial ser\u00e1 en Bogot\u00e1, pero planeamos expandirnos r\u00e1pidamente a otras ciudades principales de Colombia. \u00danete a la lista de espera y te avisaremos cuando estemos en tu ciudad.',
  },
  {
    q: '\u00bfMis datos est\u00e1n seguros?',
    a: 'Absolutamente. Cumplimos con la Ley 1581 de Protecci\u00f3n de Datos Personales. Tus datos son encriptados, nunca se comparten sin tu autorizaci\u00f3n y t\u00fa decides qu\u00e9 informaci\u00f3n incluir en tu perfil.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a,
    },
  })),
};
---

<Layout
  title="Para inquilinos \u2014 Renty | Arrienda con tu historial, no con el de otros"
  description="Renty permite a los inquilinos colombianos arrendar sin codeudor, usando su historial de pago real como garant\u00eda. Crea tu perfil gratis y obt\u00e9n tu Renty Score."
  canonicalUrl="https://rentyco.app/inquilinos"
  ogSlug="inquilinos"
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Para inquilinos', url: '/inquilinos' },
  ]}
  jsonLd={faqSchema}
>
  <Navbar />
  <main id="main-content" tabindex="-1">
    <!-- HERO -->
    <section data-section-hero class="relative flex min-h-[85vh] items-center overflow-hidden px-6 pt-24 pb-16 lg:px-12">
      <div class="pointer-events-none absolute -right-32 -top-32 h-[500px] w-[500px] rounded-full opacity-[0.07]" style="background: radial-gradient(circle, var(--color-teal) 0%, transparent 70%);"></div>
      <div class="pointer-events-none absolute -left-48 bottom-0 h-[400px] w-[400px] rounded-full opacity-[0.05]" style="background: radial-gradient(circle, var(--color-coral) 0%, transparent 70%);"></div>

      <div class="mx-auto max-w-7xl">
        <div class="mx-auto max-w-3xl text-center">
          <div data-hero-label class="mb-5 inline-flex items-center gap-2 rounded-full border border-teal/20 bg-teal-lighter px-4 py-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-teal animate-pulse"></span>
            <span class="font-heading text-[13px] font-600 text-teal-dark">Para inquilinos</span>
          </div>

          <h1 data-hero-title class="font-display text-[clamp(2.2rem,5vw,3.8rem)] leading-[1.1] tracking-tight text-ink">
            <span class="block">Arrienda con tu historial,</span>
            <span class="block text-teal">no con el de otros.</span>
          </h1>

          <p data-hero-text class="mx-auto mt-6 max-w-xl font-body text-lg leading-relaxed text-ink-secondary">
            Llevas a&ntilde;os pagando arriendo puntualmente. Pero el sistema no te reconoce porque no tienes codeudor, patrimonio o contrato formal. Con Renty, tu historial de pago es tu mejor garant&iacute;a.
          </p>

          <div data-hero-ctas class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a
              href="#waitlist"
              class="inline-flex items-center justify-center gap-2 rounded-xl bg-teal px-7 py-3.5 font-heading text-[15px] font-600 text-white no-underline shadow-lg shadow-teal/20 transition-all duration-200 hover:-translate-y-0.5 hover:bg-teal-dark hover:shadow-xl hover:shadow-teal/25"
            >
              Quiero mi Renty Score
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
            <a
              href="#como-funciona-inquilinos"
              class="inline-flex items-center justify-center rounded-xl border border-border bg-white px-7 py-3.5 font-heading text-[15px] font-600 text-ink no-underline transition-all duration-200 hover:border-teal hover:text-teal"
            >
              C&oacute;mo funciona
            </a>
          </div>

          <div data-hero-proof class="mx-auto mt-8 flex items-center justify-center gap-6 border-t border-border pt-6">
            <div class="flex -space-x-2">
              <div class="h-8 w-8 rounded-full bg-teal-lighter border-2 border-sand flex items-center justify-center font-heading text-[10px] font-700 text-teal">CM</div>
              <div class="h-8 w-8 rounded-full bg-coral-light border-2 border-sand flex items-center justify-center font-heading text-[10px] font-700 text-coral">JR</div>
              <div class="h-8 w-8 rounded-full bg-teal-lighter border-2 border-sand flex items-center justify-center font-heading text-[10px] font-700 text-teal">LP</div>
              <div class="h-8 w-8 rounded-full bg-sand-dark border-2 border-sand flex items-center justify-center font-heading text-[10px] font-700 text-ink-muted">+</div>
            </div>
            <span class="font-body text-sm text-ink-muted">
              <strong class="text-ink-secondary">{WAITLIST_COUNT_LABEL}</strong> familias en lista de espera
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- PAIN POINTS -->
    <section data-section-pain class="bg-sand-dark py-24 lg:py-32" id="problemas-inquilinos">
      <div class="mx-auto max-w-7xl px-6 lg:px-12">
        <div data-pain-header class="mx-auto mb-14 max-w-2xl text-center lg:mb-20">
          <span class="mb-3 inline-block font-mono text-[12px] font-500 tracking-[0.12em] uppercase text-coral">
            Lo que enfrentas hoy
          </span>
          <h2 class="font-display text-[clamp(1.8rem,4vw,2.8rem)] leading-tight text-ink">
            El sistema de arriendos<br />no est&aacute; hecho para ti.
          </h2>
          <p class="mt-4 font-body text-lg leading-relaxed text-ink-secondary">
            Si eres inquilino en Colombia, ya conoces estas barreras. No importa cu&aacute;ntos a&ntilde;os lleves pagando bien &mdash; el sistema mide cu&aacute;nto tienes, no c&oacute;mo pagas.
          </p>
        </div>

        <div data-pain-cards class="grid gap-5 md:grid-cols-2">
          {painPoints.map((point) => (
            <div data-pain-card class="group rounded-2xl border border-border bg-surface p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-black/[0.03]">
              <div class="mb-4 flex items-start justify-between gap-4">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-coral-light text-coral">
                  <div class="h-6 w-6" set:html={point.icon} />
                </div>
                <span class="font-mono text-[clamp(1.8rem,3vw,2.4rem)] font-500 leading-none text-coral/80">
                  {point.stat}{point.suffix}
                </span>
              </div>
              <h3 class="mb-2 font-heading text-[16px] font-700 text-ink">{point.title}</h3>
              <p class="font-body text-[14px] leading-relaxed text-ink-muted">{point.desc}</p>
              <span class="mt-3 block font-mono text-[11px] text-ink-muted/60">{point.source}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CON RENTY - SOLUTIONS -->
    <section data-section-solutions class="py-24 lg:py-32" id="como-funciona-inquilinos">
      <div class="mx-auto max-w-7xl px-6 lg:px-12">
        <div data-solutions-header class="mx-auto mb-14 max-w-2xl text-center lg:mb-20">
          <span class="mb-3 inline-block font-mono text-[12px] font-500 tracking-[0.12em] uppercase text-teal">
            Con Renty
          </span>
          <h2 class="font-display text-[clamp(1.8rem,4vw,2.8rem)] leading-tight text-ink">
            Cada barrera tiene<br /><span class="text-teal">una soluci&oacute;n.</span>
          </h2>
          <p class="mt-4 font-body text-lg leading-relaxed text-ink-secondary">
            Renty transforma tu historial real de pago en una garant&iacute;a verificada. As&iacute; es como resolvemos cada problema.
          </p>
        </div>

        <div data-solutions-grid class="grid gap-6 md:grid-cols-2">
          {solutions.map((item) => (
            <div data-solution-card class="rounded-2xl border-2 border-teal/10 bg-teal-lighter/20 p-8 transition-all duration-300 hover:-translate-y-1 hover:border-teal/20 hover:shadow-lg hover:shadow-teal/[0.04]">
              <div class="mb-4 flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-coral/10 text-coral text-xs line-through decoration-coral/40">&times;</span>
                <span class="font-body text-[14px] text-ink-muted line-through decoration-ink-muted/30">{item.problem}</span>
              </div>
              <div class="mb-3 flex items-start gap-3">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-teal/10 text-teal text-xs">&check;</span>
                <span class="font-heading text-[16px] font-700 text-teal-dark">{item.solution}</span>
              </div>
              <p class="ml-8 font-body text-[14px] leading-relaxed text-ink-secondary">{item.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- USER JOURNEY -->
    <section data-section-journey class="bg-sand-dark py-24 lg:py-32" id="tu-proceso">
      <div class="mx-auto max-w-7xl px-6 lg:px-12">
        <div data-journey-header class="mx-auto mb-14 max-w-2xl text-center lg:mb-20">
          <span class="mb-3 inline-block font-mono text-[12px] font-500 tracking-[0.12em] uppercase text-teal">
            Tu proceso
          </span>
          <h2 class="font-display text-[clamp(1.8rem,4vw,2.8rem)] leading-tight text-ink">
            De la lista de espera<br />a tu nuevo hogar.
          </h2>
        </div>

        <div data-journey-steps class="relative">
          <!-- Vertical timeline line (mobile) / Horizontal (desktop) -->
          <div data-journey-line class="absolute left-[19px] top-0 bottom-0 w-px bg-border md:left-0 md:right-0 md:top-[28px] md:bottom-auto md:h-px md:w-full"></div>

          <div class="grid gap-8 md:grid-cols-5 md:gap-6">
            {journey.map((step) => (
              <div data-journey-step class="relative flex gap-5 md:flex-col md:items-center md:text-center">
                <div class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full font-mono text-[13px] font-500 text-white shadow-md" style={`background-color: ${step.color}; box-shadow: 0 4px 12px ${step.color}33;`}>
                  {step.n}
                </div>
                <div class="pb-2">
                  <h3 class="mb-1 font-heading text-[15px] font-700 text-ink">{step.title}</h3>
                  <p class="font-body text-[13px] leading-relaxed text-ink-muted">{step.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIAL -->
    <section data-section-testimonial class="py-24 lg:py-32">
      <div class="mx-auto max-w-3xl px-6 lg:px-12">
        <span class="mb-8 block text-center font-mono text-[12px] font-500 tracking-[0.12em] uppercase text-coral">
          Historia representativa
        </span>
        <div class="relative mb-8 pl-7">
          <div data-testimonial-line class="absolute top-1 bottom-1 left-0 w-[3px] rounded-full bg-teal"></div>
          <blockquote data-testimonial-quote class="font-display text-[clamp(1.2rem,3vw,1.6rem)] leading-[1.5] text-ink">
            &ldquo;Llevo 10 a&ntilde;os pagando arriendo sin fallar un solo mes. Pero cuando quise cambiarme de apartamento, me rechazaron en 4 inmobiliarias porque no tengo codeudor con finca ra&iacute;z. 10 a&ntilde;os pagando no sirven de nada en este sistema.&rdquo;
          </blockquote>
        </div>
        <p data-testimonial-narrative class="max-w-2xl font-body text-[15px] leading-relaxed text-ink-muted">
          Esta inquilina vive en Bogot&aacute; y paga arriendo puntualmente desde 2016. Trabaja como independiente, tiene sus servicios al d&iacute;a, jam&aacute;s un atraso. Pero para el sistema formal, ella no existe. Como el 55.8% de colombianos en la informalidad, su historial es invisible.
        </p>
        <div data-testimonial-attr class="mt-8 flex items-center gap-4 border-t border-border pt-7">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-teal-lighter font-heading text-sm font-700 text-teal">CM</div>
          <div>
            <span class="block font-heading text-[15px] font-600 text-ink">Camila M.</span>
            <span class="font-body text-[13px] text-ink-muted">Trabajadora independiente &mdash; Bogot&aacute;, 10 a&ntilde;os arrendando</span>
          </div>
        </div>
        <p class="mt-6 font-mono text-[11px] leading-relaxed text-ink-muted/70">
          * Historia basada en casos recurrentes recopilados en nuestra investigaci&oacute;n. Nombre modificado por privacidad.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section data-section-faq class="bg-sand-dark py-24 lg:py-32" id="preguntas-inquilinos">
      <div class="mx-auto max-w-3xl px-6 lg:px-12">
        <div data-faq-header class="mb-14 text-center">
          <span class="mb-3 inline-block font-mono text-[12px] font-500 tracking-[0.12em] uppercase text-teal">
            Preguntas frecuentes
          </span>
          <h2 class="font-display text-[clamp(1.8rem,4vw,2.8rem)] leading-tight text-ink">
            Todo lo que necesitas saber.
          </h2>
        </div>

        <div data-faq-list class="space-y-4">
          {faqs.map((faq, i) => (
            <details data-faq-item class="group rounded-2xl border border-border bg-surface transition-all duration-200 hover:shadow-sm open:shadow-md open:shadow-black/[0.03]">
              <summary class="flex cursor-pointer items-center justify-between gap-4 px-7 py-5 font-heading text-[15px] font-600 text-ink [&::-webkit-details-marker]:hidden list-none">
                <span>{faq.q}</span>
                <svg class="h-5 w-5 shrink-0 text-ink-muted transition-transform duration-200 group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
              </summary>
              <div class="px-7 pb-6 pt-0">
                <p class="font-body text-[14px] leading-relaxed text-ink-secondary">{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA / WAITLIST -->
    <div data-section-cta>
      <WaitlistForm
        dark
        sectionId="waitlist"
        title="Quiero mi Renty Score"
        subtitle="Sé de los primeros en demostrar que tu historial de pago vale más que un codeudor. Sin costo. Sin compromiso."
        submitLabel="Unirme a la lista"
      />
    </div>
  </main>
  <Footer />
</Layout>

<!-- GSAP ANIMATIONS (inquilinos-specific) -->
<script>
  import { gsap, reveal, reducedMotion } from '../lib/gsap';

  if (!reducedMotion) {
    // Pain points
    reveal('[data-pain-header] > *', { y: 24, opacity: 0, stagger: 0.15, duration: 0.6 }, '[data-section-pain]');
    reveal('[data-pain-card]', { y: 28, opacity: 0, stagger: 0.12, duration: 0.6 }, '[data-pain-cards]');

    // Solutions
    reveal('[data-solutions-header] > *', { y: 24, opacity: 0, stagger: 0.15, duration: 0.6 }, '[data-section-solutions]');
    reveal('[data-solution-card]', { y: 24, opacity: 0, stagger: 0.15, duration: 0.6 }, '[data-solutions-grid]');

    // Journey
    reveal('[data-journey-header] > *', { y: 24, opacity: 0, stagger: 0.15, duration: 0.6 }, '[data-section-journey]');
    reveal('[data-journey-step]', { y: 24, opacity: 0, stagger: 0.15, duration: 0.6 }, '[data-journey-steps]');
    gsap.fromTo('[data-journey-line]',
      { scaleY: 0, scaleX: 0 },
      {
        scaleY: 1, scaleX: 1, transformOrigin: 'top left', duration: 1.2, ease: 'power2.inOut', force3D: true,
        scrollTrigger: { trigger: '[data-section-journey]', start: 'top 80%', once: true },
      }
    );

    // Testimonial
    gsap.fromTo('[data-section-testimonial] [data-testimonial-line]',
      { scaleY: 0 },
      {
        scaleY: 1, transformOrigin: 'top', duration: 0.8, ease: 'power2.out', force3D: true,
        scrollTrigger: { trigger: '[data-section-testimonial]', start: 'top 75%', once: true },
      }
    );
    reveal('[data-section-testimonial] [data-testimonial-quote]', { x: -20, opacity: 0, duration: 0.7 }, '[data-section-testimonial]');
    reveal('[data-section-testimonial] [data-testimonial-narrative]', { opacity: 0, duration: 0.6, delay: 0.2 }, '[data-section-testimonial]');
    reveal('[data-section-testimonial] [data-testimonial-attr]', { y: 16, opacity: 0, duration: 0.5, delay: 0.4 }, '[data-section-testimonial]');

    // FAQ
    reveal('[data-faq-header] > *', { y: 24, opacity: 0, stagger: 0.15, duration: 0.6 }, '[data-section-faq]');
    reveal('[data-faq-item]', { y: 16, opacity: 0, stagger: 0.1, duration: 0.5 }, '[data-faq-list]');

    // CTA (waitlist form)
    reveal('[data-section-cta] [data-waitlist-heading], [data-section-cta] [data-waitlist-subheading], [data-section-cta] [data-waitlist-card]', { y: 24, opacity: 0, stagger: 0.12, duration: 0.6 }, '[data-section-cta]');
  }
</script>
